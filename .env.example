# ─────────────────────────────────────────────────────────────
#  Бот-ретранслятор — переменные окружения
#  Скопируйте в .env и заполните.  .env не коммитится.
# ─────────────────────────────────────────────────────────────

# Токен от @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# ID вашей приватной группы с включёнными темами.
# Как узнать: добавьте бота в группу, запустите `npm run dev`,
# напишите что-нибудь в группе — id появится в логе.
GROUP_ID=

# polling — бот сам опрашивает Telegram. Публичный адрес не нужен.
#           Подходит и для локальной работы, и для небольшого потока в production.
# webhook — Telegram стучится к нам сам. Нужен https-адрес.
MODE=polling

# ─── Только для MODE=webhook ─────────────────────────────────
PORT=3000
# Публичный https-адрес приложения, без слэша на конце
PUBLIC_URL=
# Секретный сегмент пути. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WEBHOOK_SECRET_PATH=
# Значение заголовка X-Telegram-Bot-Api-Secret-Token (A-Z a-z 0-9 _ -)
WEBHOOK_SECRET_TOKEN=

# ─── Прочее ──────────────────────────────────────────────────
DB_FILE=./data/relay.db
LOG_LEVEL=info

# Ставить ли 👌 на ваше сообщение после успешной доставки клиенту
CONFIRM_WITH_REACTION=1

# Единственное автоматическое сообщение во всей системе — ответ на /start.
# По умолчанию выключено: бот не пишет клиенту ничего сам.
# Заполните, только если хотите приветствие.
WELCOME_TEXT=
